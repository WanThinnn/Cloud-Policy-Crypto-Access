# ==========================================
# QUICK START & TLS INSTRUCTIONS
# ==========================================
# By default, the system uses TLS (HTTPS) with sample certificates located in ./config/certs
# If you don't want to generate your own certificates and just want to test the system:
# 1. You can use the provided sample certificates.
# 2. YOU MUST ADD the following line to your OS hosts file (/etc/hosts or C:\Windows\System32\drivers\etc\hosts):
#    127.0.0.1  cloudsafe.cyberfortress.local vault.cyberfortress.local pki_signer.cyberfortress.local redis_cache.cyberfortress.local
#
# If you want to disable the external HTTPS (Nginx) and test locally via HTTP:
# Set USE_EXTERNAL_TLS=False below, and change WEBAUTHN_ORIGIN to http://localhost:8080
USE_EXTERNAL_TLS=True

# ==========================================
# 1. CORE DJANGO SETTINGS
# ==========================================
# Django Configuration
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# 2. EXTERNAL DOMAIN & PASSKEY SETTINGS
# ==========================================
# PQC SSL Certificate Settings (Used for Nginx and Passkey)
DOMAIN_NAME=cloudsafe.cyberfortress.local
# INTERNAL_DOMAIN is used for internal Docker network aliases (vault, redis, etc) to match the cert domain
INTERNAL_DOMAIN=cyberfortress.local

# Pass Key Configuration
WEBAUTHN_RP_ID=cloudsafe.cyberfortress.local
WEBAUTHN_RP_NAME=Cloud Policy Crypto Access
WEBAUTHN_ORIGIN=https://cloudsafe.cyberfortress.local


# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# 3. SSL / TLS CERTIFICATES
# ==========================================
# By default, the system uses the self-signed CyberFortress wildcard certs.
# To use your own domain certificates, place your .crt and .key files in a folder on your host machine
# and specify the directory and their EXACT filenames below:

# Directory on your host machine where certificates are stored
CERTS_DIR=./config/certs

# System Internal Certificates (Redis, Vault, PKI)
ROOT_CA_FILENAME=CyberFortress-RootCA.crt
TLS_CERT_FILENAME=_.cyberfortress.local.crt
TLS_KEY_FILENAME=_.cyberfortress.local.key

# Post-Quantum Certificates (for Nginx public endpoint)
PQC_SSL_CA_FILE=pq-CyberFortress-RootCA.crt
PQC_SSL_CERT_FILE=_.pq-cyberfortress.local.crt
PQC_SSL_KEY_FILE=_.pq-cyberfortress.local.key

# ==========================================
# 4. DATABASE CONFIGURATION
# ==========================================
# OPTION 1: Cloud Database (Supabase PostgreSQL - Recommended for Production)
# Enter your PostgreSQL connection URL here (Uncomment to use)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# OPTION 2: Local Database (SQLite - For Testing/Development Offline)
# If you use Local SQLite, the database file will be stored in the DB_DIR directory on your host.
DATABASE_URL=sqlite:////app/data/db.sqlite3

# DB_DIR: The directory on your host machine to mount the SQLite database (e.g., ./data)
# (Data remains safe in this directory even if containers are destroyed)
DB_DIR=./data

# ==========================================
# 5. SUPABASE CLOUD STORAGE
# ==========================================
# CRITICAL NOTE:
# Regardless of whether you use Local Database or Cloud Database above,
# ALL ENCRYPTED CP-ABE FILES MUST be stored on Supabase Cloud Storage.
# The system does not support storing encrypted files on local disk to ensure high security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ==========================================
# 6. REDIS CONFIGURATION (Caching & Sessions)
# ==========================================
REDIS_URL=rediss://:strongpassword123@redis_cache.cyberfortress.local:6379/1
REDIS_PASSWORD=strongpassword123
REDIS_USE_TLS=True

# ==========================================
# 7. VAULT CONFIGURATION (Secrets Management)
# ==========================================
# Used for storing Database Master Key and CP-ABE Master Key
VAULT_ADDR=https://vault.cyberfortress.local:8200
VAULT_TOKEN=root
VAULT_SECRET_PATH=secret/data/crypto_access

# ==========================================
# 8. PKI SIGNER CONFIGURATION
# ==========================================
PKI_SIGNER_URL=https://pki_signer.cyberfortress.local:5000
# python -c "import secrets; print(secrets.token_hex(32))"
PKI_AUTH_TOKEN=your-random-secure-pki-token-here

# ==========================================
# 9. SECURITY & ENCRYPTION FEATURES
# ==========================================
# Post-Quantum Cryptography ML-DSA, default enable
ENABLE_PQC_FEATURES=True

# SQL Database Field Encryption
# Enabled by default
FIELD_ENCRYPTION=True

# Master Key for Database Field Encryption (AES-256-GCM + HKDF-SHA3-256)
# Note: Thanks to HKDF cryptographic compression, this Master Key can be ANY length.
# Whether it is 1 byte or 1536 bytes (12288-bit), it will always be safely compressed down to exactly 256 bits for AES.
# If you ARE using HashiCorp Vault, leave this blank and the system will auto-generate a massive 12288-bit key.
# If you are NOT using Vault, you MUST provide a valid base64 key here.
# - Recommended (256-bit): python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# - Monster Size (12288-bit): python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(1536)).decode())"
MASTER_FIELD_ENCRYPTION_KEY=

# CPABE Keys Configuration
# KEYS_DIR: Path to keys folder on host (CP-ABE keys, Vault unseal keys, token). Leave blank to use container volume (not recommended).
KEYS_DIR=

# ==========================================
# 10. EMAIL CONFIGURATION
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ==========================================
# 11. ADMIN CONFIGURATION
# ==========================================
ADMIN_EMAIL=admin@example.com

# ==========================================
# 12. CLOUDFLARE TUNNEL CONFIGURATION
# ==========================================
CLOUDFLARE_TUNNEL_ID=
TUNNEL_DOMAIN=
CLOUDFLARE_CONFIG=./config/cloudflare/config.yml
CLOUDFLARE_CREDENTIALS_FILE=./config/cloudflare/<your-file>.json

# ==========================================
# 13. VAULT ABE PLUGIN INTEGRATION
# ==========================================
# If True, offloads CP-ABE crypto processing to the HashiCorp Vault ABE plugin.
# If False, uses local .so/.dll via ctypes (Legacy mode).
USE_VAULT_ABE_PLUGIN=False

# The ABE Scheme to use (ac17 or tkn20). Default is ac17 for backward compatibility.
CPABE_SCHEME=ac17

# ==========================================
# 14. PKI ORGANIZATION DETAILS (VPN & Web)
# ==========================================
# Customize these values to use your own organization name in generated certificates.
# DOMAIN_NAME=company.com
# VPN_PUBLIC_IP=
# COMPANY_NAME=CyberFortress
# COUNTRY=VN
# STATE=Ho Chi Minh
# LOCALITY=Thu Duc
# ORG=VNU
# ORG_UNIT=UIT
