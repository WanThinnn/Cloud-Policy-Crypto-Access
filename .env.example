# Django Configuration
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Database Configuration
# ==========================================
# OPTION 1: Cloud Database (Supabase PostgreSQL - Recommended for Production)
# Enter your PostgreSQL connection URL here (Uncomment to use)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# OPTION 2: Local Database (SQLite - For Testing/Development Offline)
# If you use Local SQLite, the database file will be stored in the DB_DIR directory on your host.
DATABASE_URL=sqlite:////app/data/db.sqlite3

# DB_DIR: The directory on your host machine to mount the SQLite database (e.g., ./data)
# (Data remains safe in this directory even if containers are destroyed)
DB_DIR=./data

# ==========================================
# Storage Configuration
# ==========================================
# CRITICAL NOTE:
# Regardless of whether you use Local Database or Cloud Database above,
# ALL ENCRYPTED CP-ABE FILES MUST be stored on Supabase Cloud Storage.
# The system does not support storing encrypted files on local disk to ensure high security.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000


# CPABE Keys Configuration
# KEYS_DIR: Path to keys folder on host (CP-ABE keys, Vault unseal keys, token). Leave blank to use container volume (not recommended).
KEYS_DIR=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_USE_TLS=False

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# Vault Configuration (Secrets Management)
# Used for storing Database Master Key and CP-ABE Master Key
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_SECRET_PATH=secret/data/crypto_access

# SQL Database Field Encryption
# Enabled by default
FIELD_ENCRYPTION=True

# AES-256-GCM encryption key
# Must be a URL-safe Base64 encoded 32-byte (256-bit) key.
# If you ARE using HashiCorp Vault, leave this blank and the system will auto-generate it.
# If you are NOT using Vault, you MUST provide a valid base64 key here.
# To generate one, run: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY= 

# Post-Quantum Cryptography ML-DSA, default enable
ENABLE_PQC_FEATURES=True

# ==========================================
# Cloudflare Tunnel Configuration
# ==========================================
CLOUDFLARE_TUNNEL_ID=
TUNNEL_DOMAIN=
CLOUDFLARE_CONFIG=./config/cloudflare/config.yml
CLOUDFLARE_CREDENTIALS_FILE=./config/cloudflare/<your-file>.json


# ==========================================
# SSL / TLS Configuration (Production)
# ==========================================
# By default, the system uses the self-signed CyberFortress wildcard certs.
# To use your own domain certificates, place your .crt and .key files in the ./certs/ folder
# and specify their EXACT filenames below:
# PQC SSL Certificate Settings
DOMAIN_NAME=cloudsafe.cyberfortress.local
PQC_SSL_CERT_FILE=_.pq-cyberfortress.local.crt
PQC_SSL_KEY_FILE=_.pq-cyberfortress.local.key
PQC_SSL_CA_FILE=pq-CyberFortress-RootCA.crt

# ==========================================
# Pass Key Configuration
# ==========================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Cloud Policy Crypto Access
WEBAUTHN_ORIGIN=https://localhost